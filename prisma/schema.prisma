// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TRAINEE
  SUPERVISOR
}


enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model User {
  id       Int    @id @default(autoincrement())
  firstName String
  lastName String 
  username String @unique
  email String @unique
  age Int
  password String
  role     Role   @default(TRAINEE)
  apps Application[]
  supervisedPrograms Program[]

  sessions Session[]
}

model Application {
  id        Int               @id @default(autoincrement())
  traineeId Int
  programId Int
  status    ApplicationStatus @default(PENDING)
  cv        String

  program   Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  trainee   User  @relation(fields: [traineeId], references: [id], onDelete: Cascade)

  @@unique([traineeId, programId])
}


model Program {
  id           Int              @id @default(autoincrement())
  title String 
  description  String
  image        String
  supervisorId Int //every program has a supervisor
  seats        Int 
  supervisor User  @relation(fields: [supervisorId], references: [id], onDelete: Cascade)

  materials Material[] 
  meetings      ProgramMeeting[] 
  applications  Application[] 
  announcements Announcement[]
}


model Material {
  id        Int     @id @default(autoincrement())
  title     String
  file      String
  
  programId Int
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
}

model ProgramMeeting {
  id        Int      @id @default(autoincrement())
  date      DateTime
  time      String
  location  String?
  url       String?
  
  programId Int
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
}


model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  
  programId Int?
  program   Program? @relation(fields: [programId], references: [id], onDelete: Cascade)
}


model Session {
id Int @id @default(autoincrement())
userId Int
user User @relation(fields: [userId], references: [id])
refreshTokenHash String
expiresAt DateTime
revokedAt DateTime?
createdAt DateTime @default(now())
@@index([userId])
}
